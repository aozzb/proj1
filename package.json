{
  "name": "webhook-delivery-service",
  "version": "0.1.0",
  "private": true,
  "description": "A service that reliably delivers webhooks to customer-supplied URLs.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/index.ts",
    "scheduler": "tsx watch src/scheduler/index.ts",
    "chaos": "tsx watch src/chaos-receiver/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker/index.js",
    "start:scheduler": "node dist/scheduler/index.js",
    "migrate": "node-pg-migrate -j js -m migrations",
    "migrate:create": "node-pg-migrate create -j js -m migrations",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "chaos:test": "node scripts/chaos-test.mjs"
  },
  "dependencies": {
    "bullmq": "^5.34.10",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8",
    "@types/supertest": "^6.0.2"
  }
}
