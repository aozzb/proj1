# Copy to .env and fill in. .env is gitignored.

# Postgres container credentials (used by docker-compose).
POSTGRES_PASSWORD=<put your password here>

# --- App config (the api container sets these itself via docker-compose) ---
# These are only needed if you run the API directly on the host instead of in
# Compose. Inside Compose, hostnames are the service names (postgres, redis).
# DATABASE_URL=postgres://webhook_user:<password>@localhost:5433/webhook_db
# REDIS_URL=redis://localhost:6379
# PORT=3000
# NODE_ENV=development
# LOG_LEVEL=debug
